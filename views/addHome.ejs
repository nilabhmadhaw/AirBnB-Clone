<%- include('partials/head') %>

<body class=<body class="min-h-screen bg-gray-100 px-5 text-gray-900">

    <%- include('partials/nav') %>

    <main class="mx-auto flex min-h-[calc(100vh-5rem)] max-w-lg items-center justify-center">

        <div class="w-full rounded-2xl border border-gray-200 bg-white p-7 shadow-lg sm:p-10">

            <header class="text-center">

                <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-rose-600">
                    Become a host
                </p>

                <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
                    Register your home
                </h1>

                <p class="mt-3 text-sm leading-6 text-gray-600 sm:text-base">
                    Enter the name of your home to get started with hosting.
                </p>

            </header>

          <form action="/host/add-home" method="POST" class="mt-8 space-y-5">

    <!-- House Name -->
    <div>
        <label
            for="houseName"
            class="mb-2 block text-sm font-semibold text-gray-700"
        >
            House name
        </label>

        <input
            id="houseName"
            type="text"
            name="houseName"
            placeholder="Enter your house name"
            class="w-full rounded-lg border border-gray-300 px-4 py-3 text-gray-900 placeholder-gray-400 outline-none transition focus:border-rose-500 focus:ring-2 focus:ring-rose-200"
            required
        />
    </div>


    <!-- Location -->
    <div>
        <label
            for="location"
            class="mb-2 block text-sm font-semibold text-gray-700"
        >
            Location
        </label>

        <input
            id="location"
            type="text"
            name="location"
            placeholder="e.g. Goa, India"
            class="w-full rounded-lg border border-gray-300 px-4 py-3 text-gray-900 placeholder-gray-400 outline-none transition focus:border-rose-500 focus:ring-2 focus:ring-rose-200"
            required
        />
    </div>


    <!-- Price -->
    <div>
        <label
            for="price"
            class="mb-2 block text-sm font-semibold text-gray-700"
        >
            Price per night
        </label>

        <input
            id="price"
            type="number"
            name="price"
            placeholder="e.g. 2500"
            min="0"
            class="w-full rounded-lg border border-gray-300 px-4 py-3 text-gray-900 placeholder-gray-400 outline-none transition focus:border-rose-500 focus:ring-2 focus:ring-rose-200"
            required
        />
    </div>


    <!-- Image -->
    <div>
        <label
            for="image"
            class="mb-2 block text-sm font-semibold text-gray-700"
        >
            Image URL
        </label>

        <input
            id="image"
            type="text"
            name="image"
            placeholder="e.g. /images/house.jpg"
            class="w-full rounded-lg border border-gray-300 px-4 py-3 text-gray-900 placeholder-gray-400 outline-none transition focus:border-rose-500 focus:ring-2 focus:ring-rose-200"
            required
        />
    </div>


    <!-- Number of Guests -->
    <div>
        <label
            for="guests"
            class="mb-2 block text-sm font-semibold text-gray-700"
        >
            Number of guests
        </label>

        <input
            id="guests"
            type="number"
            name="guests"
            placeholder="e.g. 4"
            min="1"
            class="w-full rounded-lg border border-gray-300 px-4 py-3 text-gray-900 placeholder-gray-400 outline-none transition focus:border-rose-500 focus:ring-2 focus:ring-rose-200"
            required
        />
    </div>


    <!-- Bedrooms -->
    <div>
        <label
            for="bedrooms"
            class="mb-2 block text-sm font-semibold text-gray-700"
        >
            Bedrooms
        </label>

        <input
            id="bedrooms"
            type="number"
            name="bedrooms"
            placeholder="e.g. 2"
            min="1"
            class="w-full rounded-lg border border-gray-300 px-4 py-3 text-gray-900 placeholder-gray-400 outline-none transition focus:border-rose-500 focus:ring-2 focus:ring-rose-200"
            required
        />
    </div>


    <!-- Description -->
    <div>
        <label
            for="description"
            class="mb-2 block text-sm font-semibold text-gray-700"
        >
            Description
        </label>

        <textarea
            id="description"
            name="description"
            rows="4"
            placeholder="Describe your home..."
            class="w-full resize-none rounded-lg border border-gray-300 px-4 py-3 text-gray-900 placeholder-gray-400 outline-none transition focus:border-rose-500 focus:ring-2 focus:ring-rose-200"
            required
        ></textarea>
    </div>


    <!-- Submit -->
    <input
        type="submit"
        value="Add Home"
        class="w-full cursor-pointer rounded-lg bg-rose-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition duration-200 hover:bg-rose-700 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-rose-500 focus:ring-offset-2"
    />

</form>

        </div>

    </main>

</body>

</html>